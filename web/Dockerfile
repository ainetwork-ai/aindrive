# syntax=docker/dockerfile:1.7

# ---- deps ----
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# .npmrc maps the @jsr scope to npm.jsr.io (@earthstar/meadowcap and its deps)
COPY package.json package-lock.json .npmrc ./
RUN npm ci

# ---- builder ----
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Payment network (testnet|mainnet) is inlined into the CLIENT bundle at build
# time (NEXT_PUBLIC_*) — a runtime-only env var would flip the server but leave
# the browser on the baked value (split-brain). Set it via --build-arg; the
# runner stage re-exports the same value so server and client always agree.
ARG NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK=testnet
ENV NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK=$NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK
# WalletConnect relay project id — also NEXT_PUBLIC_* (client-bundle inlined),
# so it must be a build arg for the same reason as the payment network.
ARG NEXT_PUBLIC_WC_PROJECT_ID=
ENV NEXT_PUBLIC_WC_PROJECT_ID=$NEXT_PUBLIC_WC_PROJECT_ID
RUN npm run build

# ---- runner ----
FROM node:22-bookworm-slim AS runner
WORKDIR /app
# Same build-arg as the builder stage: bakes the server-side value into the
# image so it can never disagree with the client bundle built above.
ARG NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK=testnet
ARG NEXT_PUBLIC_WC_PROJECT_ID=
ENV NEXT_PUBLIC_WC_PROJECT_ID=$NEXT_PUBLIC_WC_PROJECT_ID
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3737 \
    AINDRIVE_SSH_PORT=2222 \
    AINDRIVE_DATA_DIR=/data \
    NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK=$NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app -d /app -s /usr/sbin/nologin app \
    && mkdir -p /data && chown -R app:app /data /app

COPY --from=builder --chown=app:app /app/node_modules ./node_modules
COPY --from=builder --chown=app:app /app/.next ./.next
# public/ holds the self-hosted Monaco runtime (generated by prebuild → copy-monaco.mjs).
# The custom server.js serves it same-origin so the CSP (script-src 'self') allows it.
COPY --from=builder --chown=app:app /app/public ./public
COPY --from=builder --chown=app:app /app/server.js ./server.js
# Git over SSH (ssh-server.ts → bundled by prebuild; docs/DEPLOY.md "Git over SSH").
COPY --from=builder --chown=app:app /app/.ssh-server ./.ssh-server
COPY --from=builder --chown=app:app /app/lib ./lib
COPY --from=builder --chown=app:app /app/drizzle ./drizzle
COPY --from=builder --chown=app:app /app/src ./src
COPY --from=builder --chown=app:app /app/shared ./shared
# Operator command (docs/DEPLOY.md "Organization drives"): docker compose exec web node scripts/org-drive.mjs …
COPY --from=builder --chown=app:app /app/scripts/org-drive.mjs ./scripts/org-drive.mjs
# Operator command (docs/DEPLOY.md "Backup and restore"): run once after putting a backup of the DB back.
COPY --from=builder --chown=app:app /app/scripts/after-restore.mjs ./scripts/after-restore.mjs
# Support command (docs/X402_PAYMENT_PENDING.md): docker exec aindrive-web-1 node scripts/x402-settlements.mjs …
COPY --from=builder --chown=app:app /app/scripts/x402-settlements.mjs ./scripts/x402-settlements.mjs
COPY --from=builder --chown=app:app /app/package.json ./package.json
COPY --from=builder --chown=app:app /app/next.config.ts ./next.config.ts

USER app
EXPOSE 3737 2222
VOLUME ["/data"]

CMD ["node", "server.js"]
