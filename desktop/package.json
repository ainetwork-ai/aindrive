{
  "name": "aindrive-desktop",
  "productName": "aindrive",
  "version": "0.2.1",
  "private": true,
  "description": "aindrive for Mac — the phone app's screens on the Mac, with its folders served from the menu bar.",
  "license": "MIT",
  "author": "AI Network",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "prepare-cli": "node scripts/prepare-cli.mjs",
    "start": "node scripts/prepare-cli.mjs && node scripts/prepare-shell.mjs && electron .",
    "dist:mac": "node scripts/build-mac.mjs",
    "test": "node --test \"src/__tests__/*.test.js\"",
    "prepare-shell": "node scripts/prepare-shell.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "exifr": "^7.1.3",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "42.11.8",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.ainetwork.aindrive",
    "productName": "aindrive",
    "copyright": "© AI Network",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**",
      "assets/**",
      "cli/**",
      "shell/**",
      "package.json",
      "!src/__tests__/**",
      "!src/shell/**",
      "!node_modules/better-sqlite3/{src,deps,docs}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/{linux,win32}/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "electronLanguages": [
      "en",
      "ko"
    ],
    "protocols": [
      {
        "name": "aindrive",
        "schemes": [
          "aindrive"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dir"
      ],
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "aindrive serves the folders you choose to share from here.",
        "NSDesktopFolderUsageDescription": "aindrive serves the folders you choose to share from here.",
        "NSDownloadsFolderUsageDescription": "aindrive serves the folders you choose to share from here.",
        "NSRemovableVolumesUsageDescription": "aindrive serves the folders you choose to share from this drive.",
        "NSNetworkVolumesUsageDescription": "aindrive serves the folders you choose to share from this volume."
      }
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
