{
  "name": "aindrive",
  "version": "0.2.7",
  "description": "Local agent for aindrive — connects any folder to a running aindrive web server (local or remote) via an outbound WebSocket. No inbound ports opened on your machine.",
  "keywords": [
    "drive",
    "tunnel",
    "file-manager",
    "self-hosted",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "aindrive": "./dist/aindrive.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "node bin/aindrive.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@earthstar/meadowcap": "npm:@jsr/earthstar__meadowcap@^0.6.4",
    "@earthstar/willow": "npm:@jsr/earthstar__willow@^0.6.1",
    "@earthstar/willow-utils": "npm:@jsr/earthstar__willow-utils@^2.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "esbuild": "^0.28.1",
    "mime-types": "^2.1.35",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "vitest": "^5.0.2",
    "ws": "^8.18.0",
    "yjs": "^13.6.30"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "qs": "^6.16.0",
    "hono": "^4.13.9",
    "@hono/node-server": "^1.19.15",
    "fast-uri": "^4.2.1",
    "ip-address": "^10.7.2",
    "nanoid": "^6.0.1"
  }
}
