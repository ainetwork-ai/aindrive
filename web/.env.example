# aindrive env template. Only *.example is committed; real .env* is gitignored.
#
# ONE file per environment — copy this to. The VALUES differ per environment
# (it's not the same file twice): prod settles real money on mainnet, dev plays
# on testnet. The per-var comments below mark which ones change.
#   .env.production — Docker deploy (prod): mainnet, real CDP keys, DEV_BYPASS
#                     OFF, https URL — PLUS the NEXT_PUBLIC_* build vars and a
#                     real SESSION_SECRET. Build/run with the flag that points
#                     Compose at it (its ${...} interpolation defaults to `.env`):
#                       docker compose --env-file .env.production up -d --build
#   .env.local      — local dev (running `node server.js` directly): testnet,
#                     DEV_BYPASS on, no CDP keys. Loaded by @next/env.
#
# Everything below is what an OPERATOR sets. Code-internal/tuning vars
# (RPC URLs, size limits, log level, trace, SQLite) all have sane defaults
# and are NOT listed here — set them only if you need to override
# (see process.env.AINDRIVE_* in the code).

# ── Core ──────────────────────────────────────────────────────────────────
# NOTE: AINDRIVE_DATA_DIR (SQLite + Yjs storage) is NOT set here — each run
# context provides it: Docker compose sets /data + a volume, the e2e harness a
# temp dir, and the code defaults to ~/.aindrive. Set it only in .env.local for
# local dev (an isolated dir, separate from prod data / the CLI's creds).

# Session JWT secret. REQUIRED in prod.  openssl rand -hex 32
AINDRIVE_SESSION_SECRET=replace-me
# Public origin (cookies + share links bind to it). Must be https:// in prod.
AINDRIVE_PUBLIC_URL=http://localhost:3737
# ainize host that runs a repo file for the drive UI's ▶ Run (POST /api/run).
#AINIZE_URL=https://ainize.ai

# ── Payments (x402) ─────────────────────────────────────────────────────────
# testnet (base-sepolia, default) or mainnet (base). NEXT_PUBLIC = inlined at
# BUILD time, so changing it needs `docker compose build`, not just a restart.
NEXT_PUBLIC_AINDRIVE_PAYMENT_NETWORK=testnet
# Skip on-chain verification for local demos (1=on). MUST be 0/unset in prod.
AINDRIVE_DEV_BYPASS_X402=0
# Facilitator that settles payments:
#   testnet → leave both unset, free public x402.org is the default.
#   mainnet → set CDP keys (https://portal.cdp.coinbase.com → API keys →
#             Secret API keys). Required; without them mainnet refuses with 503.
#CDP_API_KEY_ID=
#CDP_API_KEY_SECRET=
# Override facilitator URL only for a self-hosted/third-party one. If set, it
# takes precedence over the CDP keys — leave UNSET on mainnet when using CDP.
#AINDRIVE_X402_FACILITATOR=
# Where an account whose paid-share settle has no known outcome is sent
# (409 payment_pending, docs/X402_PAYMENT_PENDING.md). `{ref}` is replaced by
# the reference, else ?ref= is appended. Default: a new GitHub issue.
#AINDRIVE_SUPPORT_URL=
# Sponsored gas for permit2-token purchases (e.g. FANCO): the ERC-7677
# paymaster RPC URL (CDP Portal → Paymaster → your Base endpoint). When set,
# smart-wallet buyers' one-time approve is paid by this paymaster (billed to
# the operator) so a buyer holding ONLY the sale token can pay — no ETH needed.
# Server-side secret (proxied via /api/paymaster, never sent to the client).
# Unset = buyers pay their own approve gas (the pre-sponsorship behaviour).
#CDP_PAYMASTER_URL=
# In-app spend caps (rolling 24h op counts) that bound paymaster drain even if
# the CDP portal policy is loose. Tune to expected volume.
#AINDRIVE_PAYMASTER_DAILY_CAP=500
#AINDRIVE_PAYMASTER_USER_DAILY_CAP=20
# REQUIRED backstop when CDP_PAYMASTER_URL is set: in the CDP Portal, scope
# the Paymaster policy to the token contract (approve to Permit2) + a hard USD
# spend cap. The /api/paymaster proxy validates each op, but the portal policy
# is the authoritative money limit — do not run sponsorship without it.
#
# NOTE: there is no global payout wallet. Each drive's owner sets its own
# payout wallet in Settings → Payments; selling is blocked until they do.

# ── Email (transactional — password-reset OTP) ──────────────────────────────
# Sends the 6-digit reset code. Reuse the ainetwork dev@ainetwork.ai mailbox
# (Gmail SMTP) — same values as the a2a-slack-notion project, no new setup:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=dev@ainetwork.ai
#   SMTP_PASS=<Gmail app password>   # copy from a2a-slack-notion/slack/.env.local
#   EMAIL_FROM=dev@ainetwork.ai
# Local dev without SMTP: set EMAIL_PROVIDER=log to print the code to the server
# console instead of sending (refuses to run in production).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── AIN SSO (optional; everything OFF unless set — web/lib/sso/README.md) ────
# Rollout follows the AIN SSO runbook (migration-rollback.md):
#   1. ISSUER + CLIENT_ID only  → provisioning adapter ({PUBLIC_URL}/api/sso) and
#      back-channel logout ({PUBLIC_URL}/api/auth/sso/backchannel-logout) live,
#      no sign-in button.
#   2. + CLIENT_SECRET + ENABLED=true → "Continue with AIN" and "Sign up with
#      AIN" next to the legacy logins (redirect_uri
#      {PUBLIC_URL}/api/auth/sso/callback, post_logout_redirect_uri
#      {PUBLIC_URL}/), the automatic sign-in check on page visits, and app
#      attestations after legacy sign-ins (CLIENT_SECRET alone is enough for those).
#   4./5. AINDRIVE_LEGACY_LOGIN=unlinked_only, then false.
# Rollback = ENABLED=false: legacy logins work again for everyone EXCEPT
# accounts AIN SSO suspended (stored per account, never undone by a switch).
# Production refuses to boot on a mistyped value (lib/boot-checks.js).
#AINDRIVE_SSO_ISSUER=https://auth.comcom.ai
#AINDRIVE_SSO_CLIENT_ID=
#AINDRIVE_SSO_CLIENT_SECRET=
#AINDRIVE_SSO_ENABLED=false
# true (default) | unlinked_only (AIN-linked accounts must use AIN) | false
# (no password/Google/wallet sign-in, signup or email reset). Only applies
# while AINDRIVE_SSO_ENABLED=true.
#AINDRIVE_LEGACY_LOGIN=true
# Automatic sign-in: a page visit without a session checks AIN SSO once per
# 30 min (prompt=none). On while ENABLED=true; false turns only this off.
#AINDRIVE_SSO_SILENT=true
# App attestations after legacy sign-ins (Google sub; company addresses aindrive
# verified). On once ISSUER + CLIENT_ID + CLIENT_SECRET are set; false = off.
#AINDRIVE_SSO_ATTEST=true
# Company domains whose verified addresses are attested (comma-separated;
# default comcom.ai; none = only Google-sub attestations).
#AINDRIVE_SSO_ATTEST_EMAIL_DOMAINS=comcom.ai
#
# Organization drives (docs/PERMISSIONS.md "Organizations"): a drive's creator
# who is an AIN SSO org admin shares it with the organization from Manage.
# Also allow named people: <org slug or id>:<aindrive user id or AIN subject>,…
# (never an email). The operator script web/scripts/org-drive.mjs needs none.
#AINDRIVE_ORG_SHARE_ALLOWLIST=comcom:acc_xxxxxxxx

# Service principals (web/lib/sso/service-principal.ts): first-party AIN applications
# that may READ org-shared drives as themselves with an AIN SSO machine token
# (client_credentials JWT, aud = AINDRIVE_PUBLIC_URL) — ainize-node cloning a
# project's repo on a push. Comma-separated client_ids at AIN SSO. Such an app is
# a viewer on the drives shared with an organization it is assigned in (the
# token's `orgs`), over git upload-pack and git-meta only; never a writer. Needs
# ISSUER + CLIENT_ID (the JWKS). Unset = no machine token is accepted.
#AINDRIVE_SSO_SERVICE_APPS=ainize

# ── Git over SSH (docs/DEPLOY.md "Git over SSH"; web/ssh-server.ts) ─────────
# `git clone git@aindrive.ainetwork.ai:<org-slug>/<repo>` — keys are looked up
# at AIN SSO with the app credentials above (ISSUER + CLIENT_ID + CLIENT_SECRET
# are required; without them the SSH server does not start). Port inside the
# container; 0 = off. The Ed25519 host key is generated on first start at
# <AINDRIVE_DATA_DIR>/ssh_host_ed25519_key (keep it: clients pin it).
#AINDRIVE_SSH_PORT=2222
#AINDRIVE_SSH_HOST=0.0.0.0
#AINDRIVE_SSH_HOST_KEY_PATH=/data/ssh_host_ed25519_key

# ── OAuth: trusted first-party apps (web/app/mcp/README.md) ────────────────
# client_ids (from POST /api/oauth/register) of the operator's own apps whose
# authorization requests skip the consent screen for a person signed in through
# AIN SSO. Comma-separated `<client_id>=<scope>+<scope>`: the scopes that may
# skip it (required; wallet:pay / drives:sell always ask). Unset = every app
# asks. A malformed entry fails the production boot.
#AINDRIVE_TRUSTED_OAUTH_CLIENTS=aind_client_…=profile+drives:read

# ── Optional ────────────────────────────────────────────────────────────────
# Accounts exempt from the per-owner file-count cap (free 1,000 / pro 100,000
# files across all of an owner's drives): comma-separated user ids and/or
# wallet addresses (matched against the wallets linked to the drive owner).
# For an app's operator account that stores many users' files in one drive
# through a PAT. Unset = every owner is capped by their tier.
#AINDRIVE_UNLIMITED_OWNERS=
# WalletConnect Cloud project id (https://cloud.walletconnect.com). Only needed
# for WalletConnect wallets; injected wallets (MetaMask/Coinbase) work without.
NEXT_PUBLIC_WC_PROJECT_ID=
